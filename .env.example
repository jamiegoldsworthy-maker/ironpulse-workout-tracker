# Firebase Project Credentials (Spark / Free Tier Compatible)
# Copy this file to .env.local for local development, or add these keys as
# GitHub Repository Secrets for automated GitHub Pages deployment.
# You can also paste your Firebase web config JSON directly inside the app's Settings tab!

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
